name("Stub on unknown server") {
    wiremock = stub
    server = nowhere
    stub {
        request {
            method = GET
            path = "/x"
        }
        response {
            status = 200
        }
    }
}

name("Stub without server") {
    wiremock = stub
    id = lone
    stub {
        request {
            method = GET
            path = "/lone"
        }
        response {
            status = 200
            body = "lone"
        }
    }
}

name("Stub with url and method keys") {
    wiremock = stub
    server = payments
    id = clash
    url = "http://ignored.invalid"
    method = GET
    stub {
        request {
            method = GET
            path = "/clash"
        }
        response {
            status = 200
            body = "mock"
        }
    }
}

name("Plain http call") {
    url = "/ping"
    method = GET
}
