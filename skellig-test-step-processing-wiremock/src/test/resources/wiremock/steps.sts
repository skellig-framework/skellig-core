name("Ordinary step") {
    id = ordinary
    values { message = "no mock server needed" }
}

name("Stub ping") {
    wiremock = stub
    server = payments
    id = ping
    stub {
        request {
            method = GET
            path = "/ping"
        }
        response {
            status = 201
            headers { "X-Stub" = first }
            body = "pong"
        }
    }
}

name("Stub ping again") {
    wiremock = stub
    server = payments
    id = ping
    stub {
        request {
            method = GET
            path = "/ping"
        }
        response {
            status = 200
            body = "pong again"
        }
    }
}

name("Stub ping on identity") {
    wiremock = stub
    server = identity
    id = ping
    stub {
        request {
            method = GET
            path = "/ping"
        }
        response {
            status = 202
            body = "identity pong"
        }
    }
}

name("Stub anonymous one") {
    wiremock = stub
