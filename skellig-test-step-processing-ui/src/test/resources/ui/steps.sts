name("Open home") {
    id = open
    ui-actions [
        {
            action = navigate
            page = home
        }
    ]
}

name("Follow next link") {
    id = follow
    ui-actions [
        {
            action = click
            target = "home.next"
        }
    ]
}

name("Open explicit URL") {
    id = explicit
    ui-actions [
        {
            action = navigate
            url = ${url}
        }
    ]
}

name("Click then fail without replay") {
    id = failure
    attempts = 3
    ui-actions [
        {
            action = click
            target = "home.next"
        },
        {
            action = click
            target = "home.missing"
        },
        {
            action = navigate
            page = home
        }
    ]
}

name("No UI work") {
    id = ordinary
    values { message = "no browser needed" }
}

name("Fail UI validation") {
    ui-actions [
        {
            action = navigate
            page = home
        }
    ]
    validate {
        url = "http://unexpected.test"
    }
}

name("Invalid navigation") {
    ui-actions [
        {
            action = navigate
            page = home
            url = "http://example.test"
        }
    ]
}

name("Fill username") {
    ui-actions [
        { action = navigate
          page = form },
        { action = type
           target = "home.username"
           value = ${username} },
        { action = type
          target = "home.username"
          value = "@" + ${domain}
          append = true },
        { action = click
          target = "home.submit" },
        { action = wait
          target = "home.submitted"
          condition = present }
    ]
}

name("Complete login") {
    id = login
    ui-actions [
        { action = navigate
          page = login },
        { action = type
          target = "home.username"
          value = ${username} },
        { action = type
          target = "home.password"
          value = ${password} },
        { action = clear
          target = "home.notes" },
        { action = select
          target = "home.textChoice"
          by = text
          value = Second },
        { action = select
          target = "home.valueChoice"
          by = value
          value = two },
        { action = check
          target = "home.remember"
          value = true },
        { action = check
          target = "home.remember"
          value = true },
        { action = check
          target = "home.remember"
          value = false },
        { action = check
          target = "home.remember"
          value = false },
        { action = check
          target = "home.remember"
          value = true },
        { action = click
          target = "home.submit" },
        { action = wait
          target = "home.dashboard"
          condition = visible }
    ]
}

name("Wait for control") {
    ui-actions [
        { action = navigate
          url = ${url} },
        { action = wait
          target = "home.marker"
          condition = ${condition} },
        { action = navigate
          page = afterWait }
    ]
}

name("Try type") {
    ui-actions [
        { action = type
          target = ${target}
          value = typed },
        { action = click
          target = "home.submit" },
        { action = wait
          target = "home.submitted"
          condition = present }
    ]
}

name("Try clear") {
    ui-actions [
        { action = clear
          target = ${target}
           },
        { action = click
          target = "home.submit" },
        { action = wait
          target = "home.submitted"
          condition = present }
    ]
}

name("Try select") {
    ui-actions [
        { action = select
          target = ${target}
          by = text
          value = Second },
        { action = click
          target = "home.submit" },
        { action = wait
          target = "home.submitted"
          condition = present }
    ]
}

name("Try check") {
    ui-actions [
        { action = check
          target = ${target}
          value = true },
        { action = click
          target = "home.submit" },
        { action = wait
          target = "home.submitted"
          condition = present }
    ]
}

name("Try wait") {
    ui-actions [
        { action = wait
          target = ${target}
          condition = ${condition} },
        { action = click
          target = "home.submit" },
        { action = wait
          target = "home.submitted"
          condition = present }
    ]
}

name("Invalid append") {
    ui-actions [
        { action = navigate
          page = home },
        { action = type
          target = "home.marker"
          value = x
          append = "yes" }
    ]
}

name("Invalid check") {
    ui-actions [
        { action = navigate
          page = home },
        { action = check
          target = "home.marker"
          value = "true" }
    ]
}

name("Invalid select") {
    ui-actions [
        { action = navigate
          page = home },
        { action = select
          target = "home.marker"
          by = index
          value = two }
    ]
}

name("Invalid wait") {
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.marker"
          condition = selected }
    ]
}

name("Invalid target") {
    ui-actions [
        { action = navigate
          page = home },
        { action = clear
          target = "home.unknown"
           }
    ]
}

name("Fail typing sensitive input") {
    ui-actions [
        { action = type
          target = "home.missing"
          value = ${password} }
    ]
}

name("Capture next control") {
    id = observed
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.next"
          condition = present }
    ]
    state {
        captured = $result.pages.home.next
    }
    validate {
        pages.home.next {
            text = Next
            present = true
        }
        get(captured).text = Next
    }
}

name("Validate saved UI control") {
    validate {
        get(captured).text = Next
        get(observed_result).pages.home.next.visible = true
    }
}

name("Scoped nested observations") {
    id = scoped
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.next"
          condition = present },
        { action = wait
          target = "home.missing"
          condition = absent },
        { action = wait
          target = "secondary.next"
          condition = present }
    ]
    validate {
        pages {
            home {
                next {
                    $.text = ${expectedText}
                    text = $.text
                    value = null
                }
                next.selected = $.missing.present
            }
        }
    }
}

name("Capture missing control") {
    ui-actions [
        { action = wait
          target = "home.missing"
          condition = absent }
    ]
    state { missingControl = $result.pages.home.missing }
    validate {
        pages.home.missing {
            present = false
            visible = false
            enabled = null
            selected = null
            text = null
            value = null
        }
    }
}

name("Capture probe then fail") {
    id = probe
    attempts = 3
    delay = 3000
    ui-actions [
        { action = wait
          target = "home.probe"
          condition = present },
        { action = wait
          target = "home.probe"
          condition = present }
    ]
    state { probeValue = $result.pages.home.probe.value }
    validate {
        pages.home.probe { value = get(probeValue) }
        pages.home.probe.value = "never-match"
    }
}

name("Validate failed snapshot") {
    validate { get(probe_result).pages.home.probe.value = get(probeValue) }
}

name("Capture via extractor") {
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.next"
          condition = present }
    ]
    state {
        extractedUiText = $result.toJson().jsonPath(${path})
    }
    validate {
        toJson().jsonPath(${path}).contains("ext") = true
        pages.home.next.text.match("N.*") = true
        pages.home.next.text.fromRegex("(N.*)") = Next
    }
}

name("Capture ambiguous control") {
    attempts = 3
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.next"
          condition = present },
        { action = navigate
          url = ${url} }
    ]
    state { ambiguousControl = $result.pages.home.next }
}

name("Capture edited form") {
    ui-actions [
        { action = navigate
          page = login },
        { action = type
          target = "home.username"
          value = alice },
        { action = check
          target = "home.remember"
          value = true },
        { action = wait
          target = "home.invisible"
          condition = present },
        { action = wait
          target = "home.disabled"
          condition = present }
    ]
    state { formSnapshot = $result.pages.home }
    validate {
        pages.home.username.value = alice
        pages.home.remember.selected = true
        pages.home.invisible {
            present = true
            visible = false
        }
        pages.home.disabled.enabled = false
    }
}

name("Capture using saved result key") {
    id = self
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.next"
          condition = present }
    ]
    state { selfText = get(self_result).pages.home.next.text }
    validate { get(self_result).pages.home.next.text = get(selfText) }
}

name("Use saved UI value") {
    ui-actions [
        { action = navigate
          page = form },
        { action = type
          target = "home.username"
          value = get(captured).text }
    ]
    validate { pages.home.username.value = Next }
}

name("Capture whole saved result") {
    id = whole
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.missing"
          condition = absent }
    ]
    state { wholeSnapshot = get(whole_result) }
    validate { get(wholeSnapshot).pages.home.missing.present = false }
}

name("Capture implicit result") {
    ui-actions [
        { action = navigate
          page = home },
        { action = wait
          target = "home.next"
          condition = present }
    ]
    state { implicitSnapshot = get("Capture implicit result_result") }
    validate { get(implicitSnapshot).pages.home.next.text = Next }
}
