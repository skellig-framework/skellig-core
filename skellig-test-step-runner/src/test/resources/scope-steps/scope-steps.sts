name ("Store the value") {
    task {
        state {
            stored = ${value}
        }
    }
}

name ("Store the value through runTest without parameters") {
    task {
        runTest("Store the value") {}
    }
}

name ("Store the value through runTest with parameters") {
    task {
        runTest("Store the value") {
            parameters {
                value = ${value}
            }
        }
    }
}

name ("Store the value through runTest with parameters of its own scope") {
    task {
        runTest("Store the value") {
            parameters {
                value = ${value}
                "skellig.scope" = "not a scope"
            }
        }
    }
}

name ("Read the seed in every expression") {
    values {
        fromProperty = get(seed)
    }
    state {
        fromStateUpdate = get(seed)
    }
    validate {
        get(seed) = ${expectedSeed}
        ${fromProperty} = ${expectedSeed}
    }
    task {
        state {
            fromTask = get(seed)
        }
    }
}
